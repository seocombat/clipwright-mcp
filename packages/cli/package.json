{
  "name": "@clipwright/cli",
  "version": "0.24.0",
  "description": "Command-line client for the Clipwright UGC video API",
  "keywords": [
    "cli",
    "ugc",
    "video",
    "text-to-video"
  ],
  "license": "MIT",
  "author": "Dimantika Sp. z o.o.",
  "homepage": "https://clipwright.io",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "clipwright": "dist/index.js",
    "clipwright-cli": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clipwright/core": "workspace:*",
    "@clipwright/sdk": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
