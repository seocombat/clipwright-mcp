{
  "name": "@clipwright/core",
  "version": "0.31.0",
  "description": "Zod schemas and the shared request/response contract of the Clipwright UGC video API",
  "repository": { "type": "git", "url": "git+https://github.com/seocombat/clipwright-mcp.git", "directory": "packages/core" },
  "license": "MIT",
  "author": "Dimantika Sp. z o.o.",
  "homepage": "https://clipwright.io/?ref=npm",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "default": "./dist/workflows.js"
    },
    "./media-timebase": {
      "types": "./dist/media-timebase.d.ts",
      "default": "./dist/media-timebase.js"
    },
    "./long-form-profile": {
      "types": "./dist/long-form-profile.d.ts",
      "default": "./dist/long-form-profile.js"
    },
    "./semantic-inserts": {
      "types": "./dist/semantic-inserts.d.ts",
      "default": "./dist/semantic-inserts.js"
    },
    "./resolved-timeline": {
      "types": "./dist/resolved-timeline.d.ts",
      "default": "./dist/resolved-timeline.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./idempotency": {
      "types": "./dist/idempotency.d.ts",
      "default": "./dist/idempotency.js"
    },
    "./voice-admission": {
      "types": "./dist/voice-admission.d.ts",
      "default": "./dist/voice-admission.js"
    },
    "./voice-listing": {
      "types": "./dist/voice-listing.d.ts",
      "default": "./dist/voice-listing.js"
    },
    "./edit": {
      "types": "./dist/edit.d.ts",
      "default": "./dist/edit.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "0.28.2"
  }
}
