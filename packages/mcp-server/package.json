{
  "name": "@clipwright/mcp-server",
  "version": "0.20.0",
  "description": "MCP server for Clipwright: generate UGC videos from your coding agent",
  "mcpName": "io.clipwright/mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "ugc",
    "video",
    "video-generation",
    "ai-avatar",
    "talking-head"
  ],
  "license": "MIT",
  "author": "Dimantika Sp. z o.o.",
  "homepage": "https://clipwright.io",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "SKILL.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "clipwright-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@clipwright/core": "workspace:*",
    "@clipwright/sdk": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
