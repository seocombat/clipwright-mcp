{
  "name": "@clipwright/mcp-server",
  "version": "0.31.0",
  "description": "MCP server for Clipwright: generate UGC videos from your coding agent",
  "mcpName": "io.clipwright/mcp",
  "repository": { "type": "git", "url": "git+https://github.com/seocombat/clipwright-mcp.git", "directory": "packages/mcp-server" },
  "keywords": [
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "ugc",
    "video",
    "video-generation",
    "ai-avatar",
    "talking-head"
  ],
  "license": "MIT",
  "author": "Dimantika Sp. z o.o.",
  "homepage": "https://clipwright.io/?ref=npm",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "SKILL.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "clipwright-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "default": "./dist/remote.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@clipwright/core": "workspace:*",
    "@clipwright/sdk": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
