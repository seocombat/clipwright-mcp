{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "removeComments": true,
    // ОТЛИЧИЕ ОТ БАЗЫ: пакет публикуется в npm, комментарии и карты остаются в репозитории.
    "sourceMap": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
