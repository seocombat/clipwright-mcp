{
  "name": "@clipwright/sdk",
  "version": "0.26.1",
  "description": "TypeScript client for the Clipwright UGC video API",
  "license": "MIT",
  "author": "Dimantika Sp. z o.o.",
  "homepage": "https://clipwright.io/?ref=npm",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clipwright/core": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
